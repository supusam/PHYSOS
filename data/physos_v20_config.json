    "temperature_only",
    "frequency_only",
    "strong_drift",
    "moderate_drift",
    "weak_drift",
    "noisy_gradual_drift",
    "sudden_change"
  ],
  "methods": [
    "temperature_level",
    "frequency_level",
    "temperature_slope",
    "frequency_slope",
    "joint_slope",
    "joint_slope_persistent_2of3"
  ],
